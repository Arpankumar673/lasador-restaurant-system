# ==============================================================================
# L'ASADOR – GRILL & BREW | ENVIRONMENT CONFIGURATION
# ==============================================================================
# Single-restaurant ordering and operations platform (Mohali, Punjab).
# Copy this file to .env.local for local development.
# NEVER commit real API keys, secrets, or .env.local to version control.
# ==============================================================================

# Supabase Project Credentials (A dedicated project for L'Asador)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Secret (NEVER expose to browser/client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Application URL for auth callbacks & redirects (default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
